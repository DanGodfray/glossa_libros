# Copia este archivo como .env y completa los valores. El archivo .env NO se sube al repositorio.
# Todas las variables son opcionales al usar la app en el WiFi de la casa.

# Contraseña para entrar a la app. Obligatoria si la publicas en internet.
APP_PASSWORD=

# Texto largo y al azar que firma la cookie de sesión. Si queda vacío, cada reinicio cierra las sesiones.
SECRET_KEY=

# Clave gratuita de Google Books API (evita el límite diario compartido).
GOOGLE_BOOKS_KEY=

# Correo de contacto que Open Library pide para identificar a la app.
OPENLIBRARY_EMAIL=
